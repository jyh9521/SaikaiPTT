# Copy to keystore.properties (which is gitignored) and fill in.
#
# Never commit the real file or the keystore itself. .claude/CLAUDE.md
# section 43.1 forbids it, and .gitignore already covers keystore.properties,
# *.jks and *.keystore.
#
# Without keystore.properties, assembleRelease still works and produces an
# unsigned APK -- useful for running Lint and the release shrinking rules
# before there is anything to publish.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore saikai-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias saikai
#
# Keep the .jks and these passwords somewhere they survive this machine:
# losing the key means no existing installation can ever be updated.

storeFile=../saikai-release.jks
storePassword=
keyAlias=saikai
keyPassword=
