<?xml version="1.0" encoding="utf-8"?>
<!--
    Languages this build actually ships.

    A locale named here is offered to the user in system Settings on Android
    13+, so it may only be listed once its resources exist: picking one with no
    translations shows Japanese while claiming to be Burmese, which is worse
    than not offering it at all.

    Task35 completed the remaining three. Burmese and Bengali still need a
    native-speaker review and a font check on the low-end reference device
    (docs/04_UI_UX.md section 35.3) before release.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ja" />
    <locale android:name="zh-CN" />
    <locale android:name="en" />
    <locale android:name="my" />
    <locale android:name="bn" />
</locale-config>
