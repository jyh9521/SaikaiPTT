<?xml version="1.0" encoding="utf-8"?>
<!--
    Default resources are Japanese: it is the product's default language
    (docs/01_PRD.md section 26), so an untranslated string falls back to
    Japanese rather than English.

    Conventions:
      - Every user-visible string lives here. Lint fails the build on
        HardcodedText (app/build.gradle.kts).
      - Counts use <plurals>, never string concatenation.
      - Dates, times and numbers are formatted against the current Locale at
        the call site, never assembled from resource fragments.
      - Language names stay in their own language and are not translated.
-->
<resources>
    <string name="app_name">西海PTT</string>

    <!-- Placeholder screen, replaced by the real Home in Task32. -->
    <string name="placeholder_subtitle">プロジェクトの初期化が完了しました</string>
    <string name="placeholder_language_label">表示言語</string>

    <!-- Debug only, removed with the placeholder screen in Task32. -->
    <string name="placeholder_service_label">通信サービス</string>
    <string name="placeholder_name_label">名前</string>
    <string name="placeholder_name_set">設定</string>
    <string name="placeholder_mic_test">マイク</string>
    <string name="placeholder_speaker_test">スピーカー</string>
    <string name="placeholder_peers_label">端末</string>
    <string name="placeholder_service_start">開始</string>
    <string name="placeholder_service_stop">停止</string>
    <string name="placeholder_talk">押して話す</string>
    <string name="placeholder_session_label">セッション</string>

    <!-- Ongoing foreground-service notification. Replaced in Task31. -->
    <string name="notification_channel_communication">通信</string>
    <string name="notification_channel_communication_description">受信を続けるために表示される通知です</string>
    <string name="notification_service_title">西海PTT</string>
    <string name="notification_service_text">受信待機中</string>

    <!-- Endonyms: a language is always offered in its own script. -->
    <string name="language_japanese" translatable="false">日本語</string>
    <string name="language_english" translatable="false">English</string>
</resources>
