<?xml version="1.0" encoding="utf-8"?>
<!--
    Default resources are Japanese: it is the product's default language
    (docs/01_PRD.md section 26), so an untranslated string falls back to
    Japanese rather than English.

    Conventions:
      - Every user-visible string lives here. Lint fails the build on
        HardcodedText (app/build.gradle.kts).
      - Counts use <plurals>, never string concatenation.
      - Dates, times and numbers are formatted against the current Locale at
        the call site, never assembled from resource fragments.
      - Language names stay in their own language and are not translated.
-->
<resources>
    <string name="app_name">西海PTT</string>

    <!-- Home screen (Task32, docs/04_UI_UX.md sections 9 to 15). -->
    <string name="home_active_user">使用中：%1$s</string>
    <string name="home_no_active_user">名前が設定されていません</string>
    <string name="home_peers_title">オンラインのデバイス</string>
    <string name="home_no_peers">現在オンラインのデバイスはありません。</string>
    <string name="home_searching">デバイスを検索しています…</string>
    <string name="home_peers_unavailable">WiFi に接続されていないため、デバイスを表示できません。</string>
    <string name="home_network_offline">WiFi に接続されていません</string>
    <string name="home_service_stopped">通信サービスは停止しています</string>
    <string name="home_service_starting">開始しています…</string>
    <string name="home_service_stopping">停止しています…</string>
    <string name="home_service_failed">通信サービスを開始できませんでした</string>
    <string name="home_service_start">開始</string>
    <string name="home_selected">選択中</string>
    <string name="home_target">対話相手：%1$s</string>
    <string name="home_target_none">相手を選んでください</string>
    <string name="home_change_user">変更</string>

    <!-- Names: the first-run screen and the management screen (Task33). -->
    <string name="welcome_title">ようこそ</string>
    <string name="welcome_description">使用する名前を作成してください。この名前は通信相手の画面に表示されます。</string>
    <string name="welcome_create">作成</string>

    <string name="user_screen_title">名前の管理</string>
    <string name="user_name_label">名前</string>
    <!-- Live counter under the field: typed characters out of the limit. -->
    <string name="user_name_counter">%1$d / %2$d</string>
    <string name="user_name_too_long">%1$d 文字以内で入力してください。</string>
    <!--
        Within the character limit but over the 64-byte wire limit. Reachable
        with ordinary names in Burmese or Bengali, so it is its own message
        rather than a repeat of the character one.
    -->
    <string name="user_name_too_long_in_bytes">この名前は長すぎます。短くしてください。</string>
    <string name="user_in_use">使用中</string>
    <string name="user_add">名前を追加</string>
    <string name="user_edit">編集</string>
    <string name="user_edit_title">名前を編集</string>
    <string name="user_delete">削除</string>
    <string name="user_delete_title">名前を削除しますか？</string>
    <string name="user_delete_body">「%1$s」を削除します。この操作は取り消せません。</string>
    <string name="user_delete_confirm">削除</string>
    <string name="user_discard_title">変更を破棄しますか？</string>
    <string name="user_discard_body">保存していない変更があります。</string>
    <string name="user_discard_confirm">破棄</string>

    <string name="user_message_in_call">通話終了後に切り替えられます。</string>
    <string name="user_message_cannot_delete_last">最後の名前は削除できません。</string>
    <string name="user_message_cannot_delete_active">使用中の名前は削除できません。先に切り替えてください。</string>
    <string name="user_message_not_found">その名前は見つかりませんでした。</string>
    <string name="user_message_name_blank">名前を入力してください。</string>
    <string name="user_message_name_rejected">この名前は使用できません。</string>

    <!-- Actions shared by more than one screen. -->
    <string name="action_back">戻る</string>
    <string name="action_cancel">キャンセル</string>
    <string name="action_save">保存</string>

    <!--
        Peer state. Shown as text beside the status shape, never as colour
        alone (docs/04_UI_UX.md section 11.3). DISCOVERED is an internal
        distinction and is shown as オンライン (section 25).
    -->
    <string name="peer_state_online">オンライン</string>
    <string name="peer_state_busy">通話中</string>
    <string name="peer_state_communicating">この端末と通話中</string>
    <string name="peer_state_offline">オフライン</string>

    <!-- The talk button and the line above it. -->
    <string name="ptt_hold_to_talk">押して話す</string>
    <string name="ptt_release_to_end">離すと終了</string>
    <string name="ptt_requesting">呼び出し中…</string>
    <string name="ptt_receiving">%1$s さんが話しています</string>
    <string name="ptt_receiving_unknown">受信中です</string>
    <string name="ptt_receiving_busy">受信中</string>
    <string name="ptt_unavailable">話せません</string>

    <!-- What happened to the last attempt (docs/04_UI_UX.md sections 21 and 22.3). -->
    <string name="ptt_message_target_busy">相手は通話中です。</string>
    <string name="ptt_message_no_response">相手が応答しません。</string>
    <string name="ptt_message_no_name">先に名前を設定してください。</string>
    <string name="ptt_message_no_microphone">マイクを使用できません。</string>
    <string name="ptt_message_app_not_visible">画面を表示したまま操作してください。</string>
    <string name="ptt_message_unreachable">相手に接続できません。</string>
    <string name="ptt_message_already_in_session">すでに通話中です。</string>
    <string name="ptt_message_interrupted">通話が中断されました。</string>

    <!--
        Debug-only controls on the Home screen. The language buttons and the
        service switch are replaced by Task35's settings screen; until then they
        are the only way to change either. Never shipped: guarded by
        BuildConfig.DEBUG, and docs/08_ReleaseChecklist.md section 43 forbids
        test UI in a release.
    -->
    <string name="debug_language_label">表示言語</string>
    <string name="debug_service_stop">サービス停止</string>

    <!-- Ongoing foreground-service notification (Task31, docs/04_UI_UX.md 18.2). -->
    <string name="notification_channel_communication">通信</string>
    <string name="notification_channel_communication_description">受信を続けるために表示される通知です</string>
    <string name="notification_service_title">西海PTT</string>
    <string name="notification_service_text">動作中です</string>
    <!-- Shown while a transmission is playing and nothing else is showing it. -->
    <string name="notification_service_receiving">受信中：%1$s</string>

    <!-- Endonyms: a language is always offered in its own script. -->
    <string name="language_japanese" translatable="false">日本語</string>
    <string name="language_english" translatable="false">English</string>
</resources>
