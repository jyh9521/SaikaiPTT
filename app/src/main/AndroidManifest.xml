<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions are declared in full here so the manifest never has to be
        revisited piecemeal. See docs/ADR/ADR-005 section 1.

        The <service> element itself is NOT declared yet: it is added in Task15
        together with the class it names. A manifest entry pointing at a class
        that does not exist fails the MissingClass lint check.
    -->

    <!-- Network. INTERNET covers UDP sockets on the LAN; the app makes no
         Internet requests except the optional one-time ASR model download
         (ADR-006). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required to receive broadcast discovery and heartbeat packets while
         the screen is off (MulticastLock, ADR-005 section 6). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Voice capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service. Android 14+ requires the type-specific permission
         matching android:foregroundServiceType. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Runtime permission from Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Overlay indicator. Granted through system settings, not a runtime dialog. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Start the receive-only service after boot (connectedDevice type only;
         Android 14+ forbids starting a microphone-type FGS from BOOT_COMPLETED). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Held only for the duration of a voice session, with a timeout. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The app is a LAN walkie-talkie: it is useless without WiFi, but must
         still install on devices whose telephony features vary. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".SaikaiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaikaiPTT">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SaikaiPTT"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
